# One origin in front of everything, because the frontend only ever uses relative
# paths (/api/..., /gateway/...). Vite's dev proxy does that in development and
# does NOT exist in a built site, so without a proxy like this the hosted frontend
# calls itself and every request 404s.
#
#   caddy run --config deploy/Caddyfile
#
# Replace :80 with the real hostname and Caddy gets a TLS certificate by itself.

:80 {
	encode gzip

	# The kitchen service: everything the frontend calls.
	handle /api/* {
		reverse_proxy localhost:8002
	}

	# The gateway: the demo reset button, and the public key any agent verifies with.
	handle /gateway/* {
		reverse_proxy localhost:8001
	}

	# Aimo's public key, the one an outside agent needs to verify a quote. This
	# used to serve the kitchen's key, so a signed quote could not be checked by
	# anyone but us. Each service's own key and health check are also reachable
	# under its prefix, which the two blocks above already pass through:
	#   /gateway/.well-known/jwks.json   /gateway/health   (Aimo's)
	#   /api/.well-known/jwks.json       /api/health       (the kitchen's)
	# The gateway does not fetch the kitchen's key through here; KITCHEN_JWKS
	# points at the kitchen directly.
	handle /.well-known/jwks.json {
		reverse_proxy localhost:8001
	}

	# The built frontend. `npm run build` writes it to Frontend/dist.
	handle {
		root * ../Frontend/dist
		try_files {path} /index.html
		file_server
	}
}

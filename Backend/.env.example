# copy to Backend/.env and fill in. never commit the real file.
JUNCTION_API_KEY=junct_...
AIMO_BASE_URL=https://junction26.valioaimo.fi
AIMO_CUSTOMER_ID=123
GEMINI_API_KEY=
DATABASE_URL=postgresql://user:pass@host:5432/db
# Optional, demo-only cutoff replay. Leave unset for the real clock. If enabled,
# choose a timestamp before the product's Aimo closingTime and disclose it.
# AIMO_CUTOFF_NOW=2026-11-12T14:59:00+02:00

# Which row in kitchen.state a kitchen owns. Leave unset on the server. Set it
# to anything (KITCHEN_STATE_ID=local) when running against the same database
# as a deployed kitchen, or the two share one row and overwrite each other.
# KITCHEN_STATE_ID=

# Which moment order cut-offs are judged at. Unset, the real clock is used.
# Set, it decides only whether a recorded closingTime counts as passed: prices,
# stock and every signature keep the real clock. For a demo of a catalogue
# whose cut-offs have all passed - check with scripts/cutoff_check.py - and say
# on stage that Aimo's recorded availability is being replayed at that moment.
# AIMO_CUTOFF_NOW=2026-11-12T10:00:00+02:00
